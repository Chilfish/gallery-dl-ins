{
  "name": "@chilfish/gallery-dl-instagram",
  "type": "module",
  "version": "0.1.0",
  "description": "Instagram extraction pipeline — platform-agnostic SDK + CLI",
  "license": "GPL-2.0-only",
  "keywords": [
    "instagram",
    "scraper",
    "downloader",
    "gallery-dl",
    "cli"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli/index.mjs",
    "./sdk": "./dist/sdk.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "gallery-dl-instagram": "./dist/cli/index.mjs"
  },
  "files": [
    "!*.log",
    "!node_modules",
    "cli/",
    "config.ts",
    "core/",
    "dist/",
    "index.ts",
    "instagram/",
    "message.ts",
    "types.ts",
    "utils/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cli": "bun cli/index.ts",
    "lint": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "axios": "^1.16.1"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^25.9.1",
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "lefthook": "^2.1.8",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "inlinedDependencies": {
    "commander": "14.0.3"
  }
}
