{
  "name": "@chilfish/gallery-dl-instagram",
  "type": "module",
  "version": "0.2.5",
  "description": "Instagram extraction pipeline — platform-agnostic SDK + CLI",
  "license": "GPL-2.0-only",
  "homepage": "https://github.com/Chilfish/gallery-dl-ins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chilfish/gallery-dl-ins.git"
  },
  "bugs": {
    "url": "https://github.com/Chilfish/gallery-dl-ins/issues"
  },
  "keywords": [
    "instagram",
    "scraper",
    "downloader",
    "gallery-dl",
    "cli"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "bin": {
    "dl-ins": "dist/dl-ins.mjs"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "cli": "bun src/cli/index.ts",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "peerDependencies": {},
  "peerDependenciesMeta": {},
  "dependencies": {},
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/node": "^26.6.6",
    "commander": "^15.1.0",
    "dotenv": "^18.0.10",
    "eslint": "^10.15.0",
    "eslint-plugin-format": "^2.0.1",
    "lefthook": "^2.2.2",
    "tsdown": "^0.23.7",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
